{
  "name": "textlab-ai-detector",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"python -m uvicorn backend.main:app --host 127.0.0.1 --port 8767 --reload\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test sites/src/*.test.mjs tools/*.test.mjs",
    "evaluate": "node tools/evaluate.mjs",
    "performance": "node tools/performance.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "4.14.0",
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  }
}
