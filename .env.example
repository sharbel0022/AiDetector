# Copy to .env. Never commit real keys or tokens.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# false avoids hidden reasoning consuming short readiness/output budgets.
# Set default to omit the field, or true for models that support thinking.
OLLAMA_THINK=false
# For OpenAI: set AI_PROVIDER=openai, AI_MODEL to an available compatible model,
# and OPENAI_API_KEY on this backend, not in the browser.
OPENAI_API_KEY=
# Optional OpenAI-compatible Chat Completions endpoint. Must support strict JSON
# schema response_format. No fallback to unstructured or fake output is used.
# AI_PROVIDER=compatible
AI_COMPATIBLE_URL=
AI_COMPATIBLE_KEY=
TEXTLAB_ENV=development
# Private mode: one server-managed access token; required for remote requests.
TEXTLAB_AUTH_MODE=private
TEXTLAB_TOKEN=
# Public multiuser mode: set TEXTLAB_AUTH_MODE=multiuser and define per-user
# SHA-256 hex hashes of random >=32-character bearer tokens (never raw tokens).
# Example shape only: {"alice":"<64 lowercase hex characters>"}
TEXTLAB_USER_TOKENS={}
# REQUIRED for multiuser: absolute path to one shared SQLite file on LOCAL disk.
# All worker processes must use this same path and these same limit settings.
# Protect the directory with OS permissions. Never place it inside dist/.
# SQLite supports multiple workers on ONE host; multi-host deployment requires
# external centralized authentication/quotas and is outside this configuration.
TEXTLAB_STATE_DB=
TEXTLAB_REQUESTS_PER_MINUTE=20
TEXTLAB_MAX_CONCURRENT=2
# Conservative daily UTC token reservations per user / all users. Reservations
# include UTF-8 input bytes, prompt overhead and maximum output tokens. They are
# not refunded after errors/cancellation; these are token allowances, not a
# currency guarantee. Also configure the provider's account spending limit.
TEXTLAB_DAILY_TOKEN_BUDGET=250000
TEXTLAB_GLOBAL_DAILY_TOKEN_BUDGET=1000000
TEXTLAB_MAX_OUTPUT_TOKENS=6000
TEXTLAB_REQUEST_TIMEOUT=120
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767
# Production requires explicit hosts (no testserver or wildcards), explicit
# HTTPS origins (HTTP permitted only on loopback), and authenticated access.
# /api/provider-status performs a synthetic real generation (max 128 tokens,
# max 15s), cached per worker for 60s on success / 5s on failure. This can incur
# provider cost and consumes the same shared quotas as rewrites.
