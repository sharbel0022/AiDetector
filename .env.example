# Copy to .env. Never commit real keys or tokens.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_URL=http://127.0.0.1:11434
# For OpenAI: set AI_PROVIDER=openai, AI_MODEL to an available compatible model,
# and OPENAI_API_KEY on this backend, not in the browser.
OPENAI_API_KEY=
TEXTLAB_ENV=development
TEXTLAB_TOKEN=
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8767,http://localhost:8767
